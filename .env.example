# Postgres connection string (Neon, Supabase, Vercel Postgres, local…).
# Leave unset to run on the built-in in-memory demo database (PGlite):
# fine for previews, but orders are lost whenever the server restarts.
DATABASE_URL=

# Secret used to sign the login session cookie. Generate one with:
#   openssl rand -base64 32
# Set it in production: if it is missing, the app falls back to a public
# built-in key (anyone could forge a login) and logs a warning.
SESSION_SECRET=
